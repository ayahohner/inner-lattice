---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Explorations in consciousness and cosmology' } = Astro.props;
const siteTitle = 'inner lattice';
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="container">
      <header>
        <a href="/" class="site-title">{siteTitle}</a>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <p>&copy; {new Date().getFullYear()}</p>
      </footer>
    </div>

    <script>
      import mermaid from 'mermaid';

      const renderMermaidDiagrams = async () => {
        const preBlocks = document.querySelectorAll('pre[data-language="mermaid"]');

        preBlocks.forEach((block) => {
          if (!(block instanceof HTMLElement)) {
            return;
          }

          const pre =
            block.tagName === 'PRE' ? block : block.closest('pre');
          const codeBlock = pre?.querySelector('code') ?? block;

          if (!pre || !codeBlock || !(codeBlock instanceof HTMLElement)) {
            return;
          }

          const text = codeBlock.textContent?.trim() ?? '';
          if (!text) return;

          const wrapper = document.createElement('div');
          wrapper.className = 'mermaid';
          wrapper.textContent = text;
          pre.replaceWith(wrapper);
        });

        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'loose',
          theme: 'default',
        });

        const mermaidNodes = Array.from(document.querySelectorAll('.mermaid'));
        if (mermaidNodes.length > 0) {
          await mermaid.run({ nodes: mermaidNodes });
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
      } else {
        renderMermaidDiagrams();
      }
    </script>
  </body>
</html>
