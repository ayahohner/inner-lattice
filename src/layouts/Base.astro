---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Explorations in consciousness and cosmology' } = Astro.props;
const siteTitle = 'inner lattice';
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="container">
      <header>
        <a href="/" class="site-title">{siteTitle}</a>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <p>&copy; {new Date().getFullYear()}</p>
      </footer>
    </div>

    <script>
      import mermaid from 'mermaid';

      const renderMermaidDiagrams = async () => {
        for (const pre of document.querySelectorAll('pre[data-language="mermaid"]')) {
          const text = pre.textContent?.trim() ?? '';
          if (!text) continue;

          const wrapper = document.createElement('div');
          wrapper.className = 'mermaid';
          wrapper.textContent = text;
          pre.replaceWith(wrapper);
        }

        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'loose',
          theme: 'base',
          themeVariables: {
            background: '#edf2f4',
            mainBkg: '#fafafa',
            secondBkg: '#f1f4f6',
            primaryColor: '#fafafa',
            primaryTextColor: '#2d2d2d',
            primaryBorderColor: '#aeb8c0',
            secondaryColor: '#edf2f4',
            secondaryTextColor: '#2d2d2d',
            secondaryBorderColor: '#c8d1d8',
            tertiaryColor: '#e8ecef',
            tertiaryTextColor: '#2d2d2d',
            tertiaryBorderColor: '#c8d1d8',
            lineColor: '#5a6b7c',
            textColor: '#2d2d2d',
            noteBkgColor: '#f7f8f4',
            noteTextColor: '#2d2d2d',
            noteBorderColor: '#d8d4bd',
            actorBkg: '#fafafa',
            actorTextColor: '#2d2d2d',
            actorBorder: '#aeb8c0',
            signalColor: '#4a5a6a',
            signalTextColor: '#2d2d2d',
          },
        });

        await mermaid.run();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
      } else {
        renderMermaidDiagrams();
      }
    </script>
  </body>
</html>
